{
  "name": "@hackbuild/drives",
  "version": "0.1.0",
  "description": "Homeostatic drives, softmax choice with commitment and a why for every choice, cue learning with associability and eligibility traces, sleep pressure and body clock, a memory stream, task gating and inference scheduling. Rust core in wasm.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-agents.git",
    "directory": "packages/drives"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inline": {
      "types": "./dist/wasm/inline.d.ts",
      "import": "./dist/wasm/inline.js"
    },
    "./wasm": "./dist/wasm/drives_bg.wasm",
    "./iife": "./dist/drives.iife.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt",
    "how.ts"
  ],
  "unpkg": "./dist/drives.iife.js",
  "jsdelivr": "./dist/drives.iife.js",
  "scripts": {
    "build": "node ../../tools/build-package.mjs drives"
  }
}
