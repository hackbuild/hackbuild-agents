{
  "name": "@hackbuild/scenario",
  "version": "0.2.0",
  "description": "Lockstep scenario runner for browser sims on puppeteer-core and the system Chrome: routed requests from pinned local files, traces, golden comparison, motion metrics, a frame sampler and reports in the check message form, with a browser entry that runs the same core against a sim in the page.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-agents.git",
    "directory": "packages/scenario"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./profiler": {
      "types": "./dist/profiler.d.ts",
      "import": "./dist/profiler.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./bundle": "./dist/scenario.bundle.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs scenario --esm"
  },
  "bin": {
    "hb-scenario": "./bin/scenario.mjs"
  },
  "peerDependencies": {
    "puppeteer-core": ">=25.18.1 <26.0.0"
  }
}
