{
  "name": "@hackbuild/senses",
  "version": "0.1.0",
  "description": "Perception for simulated animals: Itti Koch saliency with world space inhibition of return, looming, odour plume and trail tracking, hearing error, field of view vision, and eye renders to an occupancy grid. Rust core in wasm.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-agents.git",
    "directory": "packages/senses"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./inline": {
      "types": "./dist/wasm/inline.d.ts",
      "import": "./dist/wasm/inline.js"
    },
    "./wasm": "./dist/wasm/senses_bg.wasm",
    "./iife": "./dist/senses.iife.js",
    "./three-iife": "./dist/senses-three.iife.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "unpkg": "./dist/senses.iife.js",
  "jsdelivr": "./dist/senses.iife.js",
  "scripts": {
    "build": "node ../../tools/build-package.mjs senses"
  },
  "peerDependencies": {
    "three": ">=0.186.1 <0.188.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
