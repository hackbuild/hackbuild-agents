{
  "name": "hackbuild-agents-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "if ls packages/*/package.json >/dev/null 2>&1; then npm run build --workspaces --if-present; else echo 'build: no workspace packages yet'; fi",
    "test": "vitest run --passWithNoTests && node --test tools/test/*.test.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p examples",
    "lint:voice": "git ls-files | grep -Ev '\\.(png|jpe?g|glb|bin|wasm|wav)$|^(LICENSES/|RULES.md|CLAUDE.md|tools/)|package-lock.json|Cargo.lock' | xargs node tools/lint-voice.mjs",
    "examples": "node tools/build-examples.mjs",
    "examples:check": "node tools/check-examples.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@virgilvox/hackbuild-ui": "file:tools/vendor/hackbuild-ui-0.4.3-692e0a4.tgz",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "puppeteer-core": "25.18.1",
    "rolldown": "1.2.19",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
